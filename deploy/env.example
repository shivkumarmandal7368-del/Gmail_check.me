# Copy to deploy/.env on the VPS (chmod 600). Loaded by systemd services.

# Residential proxy — required for Gmail checker / device check
# Format: http://USER:PASS@host:port  (http scheme recommended)
PROXY_URL=

# Express session signing (generate: openssl rand -hex 32)
SESSION_SECRET=

# API server
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# Frontend (Vite preview serves built static + proxies /api)
WEB_PORT=5173
API_PORT=8080
BASE_PATH=/

# Optional: public hostname for nginx (server_name in deploy/nginx/vanguard.conf)
# DOMAIN=checker.example.com
