# Copy to deploy/.env on the VPS (chmod 600). Loaded by systemd services.

# Residential proxy — required for Gmail checker / device check
# Format: http://USER:PASS@host:port  (http scheme recommended)
PROXY_URL=

# Phone / LocalToNet proxy: skip slow geo retries + cache IP 3 min (default on)
# PROXY_PHONE_MODE=1
# GEO_CACHE_SECONDS=180
# Optional: google.com warmup before sign-in (default off on phone proxy — faster)
# PHONE_WARMUP=1

# Optional: auto-solve Google reCAPTCHA image puzzles (2Captcha or CapSolver)
# Get a key at https://2captcha.com or https://capsolver.com
# CAPTCHA_API_KEY=
# CAPTCHA_PROVIDER=2captcha
# CAPTCHA_TIMEOUT=180
# Free audio captcha (local Whisper, no balance): default on
# CAPTCHA_FREE_AUDIO=1
# WHISPER_MODEL=base.en
# CAPTCHA_FREE_VISION=1
# YOLO_CONF=0.18

# Express session signing (generate: openssl rand -hex 32)
SESSION_SECRET=

# API server
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# Frontend (Vite preview serves built static + proxies /api)
WEB_PORT=5173
API_PORT=8080
BASE_PATH=/

# Optional: public hostname for nginx (server_name in deploy/nginx/vanguard.conf)
# DOMAIN=checker.example.com
